# Copy to .env and fill in.  .env holds passwords: it is git-ignored, keep it
# that way.  Names and passwords: letters, digits, . _ - only; passwords at
# least 12 characters.  `openssl rand -hex 16` makes a good one.

# This host's LAN address — Asterisk listens on it only (UDP + TCP 5060)
SERVER_IP=192.168.1.10
LOCAL_NET=192.168.1.0/24

# The gateway phone: fixed address (DHCP reservation) and its SIP account
GATEWAY_IP=192.168.1.20
GATEWAY_USER=gateway
GATEWAY_PASSWORD=

# Space-separated name:password pairs.  Every registered client rings on an
# incoming GSM call and gets every incoming SMS.
CLIENTS="alice: bob:"
