<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- ═══ Main tabbed layout ═══ -->
    <LinearLayout
        android:id="@+id/tabbedRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Tab content area (fills space above bottom bar) -->
        <FrameLayout
            android:id="@+id/tabContent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- ── TAB 0: Home (default view) ── -->
            <LinearLayout
                android:id="@+id/tabHome"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone"
                android:padding="14dp">

                <!-- Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GSM2SIP"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/tvHomeStatusPill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="● Offline"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_secondary"
                        android:background="@drawable/input_bg"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:layout_marginStart="10dp" />

                    <TextView
                        android:id="@+id/tvHomeTlsBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TLS"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/tls_badge"
                        android:background="@drawable/input_bg"
                        android:drawableStart="@drawable/ic_shield_lock"
                        android:drawablePadding="4dp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:layout_marginStart="6dp"
                        android:visibility="gone" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageButton
                        android:id="@+id/btnHomeMenu"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:src="@drawable/ic_gear"
                        android:background="@drawable/input_bg"
                        android:contentDescription="Menu" />
                </LinearLayout>

                <!-- Link state: the two networks this gateway depends on.
                     Both legs matter — a call needs the modem for GSM and WiFi
                     for SIP/RTP — so both are shown together. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <TextView
                        android:id="@+id/tvNetMobile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="—"
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:textColor="@color/text_secondary"
                        android:background="@drawable/input_bg"
                        android:padding="8dp"
                        android:layout_marginEnd="4dp"
                        android:singleLine="true"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tvNetWifi"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="—"
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:textColor="@color/text_secondary"
                        android:background="@drawable/input_bg"
                        android:padding="8dp"
                        android:layout_marginStart="4dp"
                        android:singleLine="true"
                        android:ellipsize="end" />
                </LinearLayout>

                <!-- Filter chips -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="16dp">

                    <Button
                        android:id="@+id/btnFilterAll"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:text="All"
                        android:textSize="13sp"
                        android:textAllCaps="false"
                        android:textColor="#052E16"
                        android:backgroundTint="#34D399"
                        android:minWidth="76dp"
                        android:minHeight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btnFilterIncoming"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:text="Incoming"
                        android:textSize="13sp"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        android:backgroundTint="@color/btn_secondary"
                        android:minWidth="76dp"
                        android:minHeight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btnFilterOutgoing"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:text="Outgoing"
                        android:textSize="13sp"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        android:backgroundTint="@color/btn_secondary"
                        android:minWidth="76dp"
                        android:minHeight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />
                </LinearLayout>

                <!-- Everything below the chips scrolls; the header and the
                     filter chips stay put so they are reachable while reading
                     a long call list. -->
                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:fillViewport="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                    <!-- Active call -->
                    <LinearLayout
                        android:id="@+id/homeCallCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/card_bg"
                        android:padding="16dp"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="● ACTIVE CALL"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="#34D399" />

                            <TextView
                                android:id="@+id/tvHomeCallDirection"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="GSM → SIP"
                                android:textSize="11sp"
                                android:textColor="@color/text_secondary"
                                android:background="@drawable/input_bg"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvHomeCallTimer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="00:00"
                            android:textSize="44sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace"
                            android:textColor="@color/text_primary"
                            android:paddingTop="10dp" />

                        <TextView
                            android:id="@+id/tvHomeCallFrom"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:paddingTop="6dp" />

                        <TextView
                            android:id="@+id/tvHomeCallTo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textSize="14sp"
                            android:textColor="#60A5FA"
                            android:paddingTop="2dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingTop="16dp">

                            <!-- Icon over label: the label carries the state
                                 (Mute/Unmute, Snoop/Stop), the icon makes the
                                 three actions distinguishable at a glance. -->
                            <Button
                                android:id="@+id/btnHomeMute"
                                android:layout_width="0dp"
                                android:layout_height="62dp"
                                android:layout_weight="1"
                                android:text="Mute"
                                android:textSize="11sp"
                                android:textColor="@color/text_primary"
                                android:backgroundTint="@color/btn_secondary"
                                android:drawableTop="@drawable/ic_fa_volume_xmark"
                                android:drawablePadding="2dp"
                                android:paddingTop="8dp"
                                android:paddingBottom="6dp"
                                android:layout_marginEnd="4dp"
                                android:minHeight="0dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp" />

                            <Button
                                android:id="@+id/btnHomeSnoop"
                                android:layout_width="0dp"
                                android:layout_height="62dp"
                                android:layout_weight="1"
                                android:text="Snoop"
                                android:textSize="11sp"
                                android:textColor="@color/text_primary"
                                android:backgroundTint="@color/btn_secondary"
                                android:drawableTop="@drawable/ic_fa_headphones"
                                android:drawablePadding="2dp"
                                android:paddingTop="8dp"
                                android:paddingBottom="6dp"
                                android:layout_marginHorizontal="4dp"
                                android:minHeight="0dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp" />

                            <Button
                                android:id="@+id/btnHomeEnd"
                                android:layout_width="0dp"
                                android:layout_height="62dp"
                                android:layout_weight="1"
                                android:text="End"
                                android:textSize="11sp"
                                android:textColor="#FFFFFF"
                                android:backgroundTint="#B91C1C"
                                android:drawableTop="@drawable/ic_fa_phone_slash"
                                android:drawablePadding="2dp"
                                android:paddingTop="8dp"
                                android:paddingBottom="6dp"
                                android:layout_marginStart="4dp"
                                android:minHeight="0dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Recent calls -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="18dp"
                        android:paddingBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="RECENT CALLS"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_secondary" />

                        <TextView
                            android:id="@+id/tvHomeTrafficDay"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Today"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/homeTrafficList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/tvHomeTrafficEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No calls yet"
                        android:textSize="13sp"
                        android:textColor="@color/text_hint"
                        android:paddingVertical="14dp" />
                    </LinearLayout>
                </ScrollView>

            </LinearLayout>

            <!-- ── Settings (full screen, replaces the old modal) ── -->
            <LinearLayout
                android:id="@+id/tabConfig"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp">

                    <ImageButton
                        android:id="@+id/btnConfigBack"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:src="@drawable/ic_arrow_back"
                        android:scaleType="centerInside"
                        android:background="@drawable/input_bg"
                        android:contentDescription="Back" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Settings"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:paddingStart="12dp" />

                    <!-- Live event log — SIP registration, calls, GSM and
                         network transitions.  The old settings screen showed
                         it inline; it has its own screen now, reached here. -->
                    <ImageButton
                        android:id="@+id/btnCfgLogs"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:src="@drawable/ic_logs"
                        android:scaleType="centerInside"
                        android:background="@drawable/input_bg"
                        android:contentDescription="Logs" />
                </LinearLayout>

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:fillViewport="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingBottom="20dp">

                        <ImageView
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="14dp"
                            android:src="@mipmap/ic_launcher"
                            android:contentDescription="gsm2sip" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:text="gsm2sip"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:paddingTop="8dp" />

                        <TextView
                            android:id="@+id/tvCfgVersion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:textSize="12sp"
                            android:textColor="@color/text_label"
                            android:paddingTop="2dp"
                            android:paddingBottom="14dp" />

                        <TextView style="@style/CfgLabel" android:text="SIP Server" />
                        <EditText android:id="@+id/etCfgServer" style="@style/CfgField"
                            android:hint="callagent.pro" android:inputType="textUri" />

                        <TextView style="@style/CfgLabel" android:text="SIP Port" />
                        <EditText android:id="@+id/etCfgPort" style="@style/CfgField"
                            android:hint="5060" android:inputType="number" />

                        <TextView style="@style/CfgLabel" android:text="SIP Username" />
                        <EditText android:id="@+id/etCfgUser" style="@style/CfgField"
                            android:hint="extension" android:inputType="text" />

                        <TextView style="@style/CfgLabel" android:text="SIP Password" />
                        <EditText android:id="@+id/etCfgPass" style="@style/CfgField"
                            android:hint="password" android:inputType="textPassword" />

                        <TextView style="@style/CfgLabel" android:text="Own Number (SIM)" />
                        <!-- One field per active SIM, built at runtime: the
                             slots a device has, and which of them hold a live
                             SIM, are only knowable on the device. -->
                        <LinearLayout
                            android:id="@+id/llCfgOwnNumbers"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Sent as the SIP destination so the server can map the call to an assistant. Without it the gateway addresses its own extension and the call loops back."
                            android:textSize="12sp"
                            android:textColor="@color/text_hint"
                            android:paddingTop="6dp" />

                        <TextView style="@style/CfgLabel" android:text="Audio Codec" />

                        <RadioGroup
                            android:id="@+id/rgCfgCodec"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="4dp">

                            <RadioButton
                                android:id="@+id/rbCodecG722"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="G.722 only — wideband 16 kHz (recommended)"
                                android:buttonTint="@color/accent"
                                android:textColor="@color/text_label" />

                            <RadioButton
                                android:id="@+id/rbCodecBoth"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="G.722 preferred, G.711 allowed"
                                android:buttonTint="@color/accent"
                                android:textColor="@color/text_label" />

                            <RadioButton
                                android:id="@+id/rbCodecG711"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="G.711 only — narrowband 8 kHz"
                                android:buttonTint="@color/accent"
                                android:textColor="@color/text_label" />
                        </RadioGroup>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Offering G.711 alongside G.722 usually means the server picks G.711 and every call is narrowband, which is why G.722 alone is the default."
                            android:textSize="12sp"
                            android:textColor="@color/text_hint"
                            android:paddingTop="6dp" />

                        <TextView style="@style/CfgLabel" android:text="Agent Volume" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="4dp">

                            <SeekBar
                                android:id="@+id/sbCfgAgentVolume"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:max="6"
                                android:progress="3"
                                android:progressTint="@color/accent"
                                android:thumbTint="@color/accent" />

                            <TextView
                                android:id="@+id/tvCfgAgentVolume"
                                android:layout_width="44dp"
                                android:layout_height="wrap_content"
                                android:gravity="end"
                                android:text="0"
                                android:textStyle="bold"
                                android:textColor="@color/text_label"
                                android:paddingStart="8dp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="How loud the agent is to the GSM caller. 0 is what the detected device asks for; each step roughly a third louder or quieter. Raise it if callers say the agent is faint, lower it if the line distorts."
                            android:textSize="12sp"
                            android:textColor="@color/text_hint"
                            android:paddingTop="6dp" />

                        <CheckBox
                            android:id="@+id/cbCfgAutoconnect"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Autoconnect on startup"
                            android:buttonTint="@color/accent"
                            android:textColor="@color/text_label"
                            android:layout_marginTop="16dp" />

                        <CheckBox
                            android:id="@+id/cbCfgUseStun"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Use STUN"
                            android:buttonTint="@color/accent"
                            android:textColor="@color/text_label"
                            android:layout_marginTop="8dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Finds the public IP so SIP and RTP survive NAT. Turn off for a SIP server on the local network."
                            android:textSize="12sp"
                            android:textColor="@color/text_hint"
                            android:paddingTop="6dp" />

                        <CheckBox
                            android:id="@+id/cbCfgTls"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Enable TLS"
                            android:buttonTint="@color/accent"
                            android:textColor="@color/text_label"
                            android:layout_marginTop="8dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Encrypts SIP signalling — registration, calls and SMS text. Call audio (RTP) is not encrypted either way. The server must offer TLS, usually on port 5061."
                            android:textSize="12sp"
                            android:textColor="@color/text_hint"
                            android:paddingTop="6dp" />

                        <CheckBox
                            android:id="@+id/cbCfgSrtp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Encrypt audio (SRTP)"
                            android:buttonTint="@color/accent"
                            android:textColor="@color/text_label"
                            android:layout_marginTop="8dp" />

                        <TextView
                            android:id="@+id/tvCfgSrtpHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="SDES-keyed SRTP (RFC 3711). Requires TLS: the keys travel inside the SIP signalling, so over plain UDP they would be readable by anyone on the path."
                            android:textSize="12sp"
                            android:textColor="@color/text_hint"
                            android:paddingTop="6dp" />

                        <CheckBox
                            android:id="@+id/cbCfgTranslit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="ASCII-only outgoing SMS"
                            android:buttonTint="@color/accent"
                            android:textColor="@color/text_label"
                            android:layout_marginTop="8dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Rewrites accents before sending: für becomes fuer. Turn on if umlauts arrive mangled. Cyrillic, Hebrew, Arabic and other non-Latin text is never rewritten — it is sent as-is."
                            android:textSize="12sp"
                            android:textColor="@color/text_hint"
                            android:paddingTop="6dp" />

                        <Button
                            android:id="@+id/btnCfgClearRecents"
                            android:layout_width="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_height="40dp"
                            android:text="CLEAR RECENTS"
                            android:textSize="12sp"
                            android:paddingStart="20dp"
                            android:paddingEnd="20dp"
                            android:textColor="#F87171"
                            android:backgroundTint="#374151"
                            android:layout_marginTop="24dp"
                            android:layout_marginBottom="20dp"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp" />

                        <Button
                            android:id="@+id/btnCfgSave"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:text="SAVE"
                            android:textStyle="bold"
                            android:textColor="@color/accent_on"
                            android:backgroundTint="@color/accent"
                            android:layout_marginTop="0dp"
                            android:minHeight="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp" />
                    </LinearLayout>
                </ScrollView>
            </LinearLayout>

            <!-- ── Logs (reached from the Settings header) ── -->
            <LinearLayout
                android:id="@+id/tabLogs"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:background="@color/background"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp">

                    <ImageButton
                        android:id="@+id/btnLogsBack"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:src="@drawable/ic_arrow_back"
                        android:scaleType="centerInside"
                        android:background="@drawable/input_bg"
                        android:contentDescription="Back" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Logs"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:paddingStart="12dp" />

                    <ImageButton
                        android:id="@+id/btnLogsCopy"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:src="@drawable/ic_copy"
                        android:scaleType="centerInside"
                        android:background="@drawable/input_bg"
                        android:contentDescription="Copy log"
                        android:layout_marginEnd="8dp" />

                    <ImageButton
                        android:id="@+id/btnLogsClear"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:src="@drawable/ic_trash"
                        android:scaleType="centerInside"
                        android:background="@drawable/input_bg"
                        android:contentDescription="Clear log" />
                </LinearLayout>

                <ScrollView
                    android:id="@+id/svLog"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@color/surface"
                    android:padding="8dp"
                    android:layout_marginHorizontal="14dp"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:id="@+id/tvLog"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_log"
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:textIsSelectable="true"
                        android:text="" />
                </ScrollView>
            </LinearLayout>


        </FrameLayout>

<!-- Bottom tab bar removed: navigation is the header menu on the home view -->
    </LinearLayout>

    <!-- ═══ Full-screen in-call overlay (above everything, hidden by default) ═══ -->
    <LinearLayout
        android:id="@+id/inCallView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/background"
        android:visibility="gone"
        android:gravity="center_horizontal">

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvInCallStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Calling..."
            android:textSize="16sp"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/tvInCallNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="32sp"
            android:textColor="@color/text_primary"
            android:fontFamily="monospace"
            android:gravity="center"
            android:paddingVertical="16dp"
            android:paddingHorizontal="24dp"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="18sp"
            android:autoSizeMaxTextSize="32sp" />

        <TextView
            android:id="@+id/tvInCallTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textSize="48sp"
            android:textColor="@color/text_primary"
            android:fontFamily="monospace"
            android:paddingVertical="24dp"
            android:visibility="gone" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Listen in on both sides through the speaker.  Does not touch the
             microphone, which stays muted for the whole call. -->
        <Button
            android:id="@+id/btnInCallMonitor"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginBottom="12dp"
            android:text="LISTEN IN"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2563EB"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <Button
            android:id="@+id/btnInCallEnd"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginBottom="32dp"
            android:text="END CALL"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#DC2626"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />
    </LinearLayout>

</FrameLayout>
